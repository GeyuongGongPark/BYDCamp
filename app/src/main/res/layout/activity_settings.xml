<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 지역 선택 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="지역"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerRegion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/field_bg"
            android:layout_marginBottom="16dp"/>

        <!-- 이메일 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BYD 이메일"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:inputType="textEmailAddress"
            android:background="@color/field_bg"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- 비밀번호 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="비밀번호"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:inputType="textPassword"
            android:background="@color/field_bg"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- 로그인 버튼 -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="로그인 테스트"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvLoginStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/accent_green"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"/>

        <!-- VIN 선택 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="차량 VIN"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerVin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/field_bg"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnFetchVin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="VIN 목록 새로고침"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/btn_settings"
            android:layout_marginBottom="24dp"/>

        <!-- PIN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="제어 PIN"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etPin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:inputType="numberPassword"
            android:background="@color/field_bg"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:maxLength="6"
            android:layout_marginBottom="24dp"/>

        <!-- 목표 온도 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="목표 온도 (°C)"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etTargetTemp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:inputType="numberDecimal"
            android:background="@color/field_bg"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- 종료 배터리% -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="종료 배터리 (%)"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etStopBattery"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:inputType="number"
            android:background="@color/field_bg"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- 최대 시간 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="최대 시간 (시간)"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etMaxHours"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:inputType="number"
            android:background="@color/field_bg"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="32dp"/>

        <!-- 저장 버튼 -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="저장"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/btn_start"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
